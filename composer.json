{
    "name": "mahery-rak/ai-product-studio",
    "description": "Plugin WordPress My AI Agent : création de produits WooCommerce via des agents IA (image, description, import CSV/Excel).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "woocommerce", "ai", "agent", "product", "generator"],
    "authors": [
        {
            "name": "Mahery RAKOTOARISON"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/x-orion-mg/my-ia-lib-2.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "x-orion-mg/my-ai-lib": "dev-master"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "AIProductStudio\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist"
    }
}
